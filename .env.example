# ============================================================================
# AI Agent 配置示例。复制为 .env 后按需修改：cp .env.example .env
# 一行 = 一个设置项；不填就用代码里的默认值（见 config.py）。
# 零密钥体验：什么都不填直接启动，会自动进入 Mock 模式（无需 API Key）。
# ============================================================================

# ---------- 模型（LLM）----------
# OpenAI 兼容接口都行：DeepSeek / Moonshot / 本地 vLLM / Ollama(OpenAI 兼容层)
OPENAI_API_KEY=
API_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL=deepseek-chat
AGENT_TEMPERATURE=0.7
MAX_TOKENS=4096
REQUEST_TIMEOUT=120

# 强制走 Mock（没填 Key 时也会自动 Mock）
MOCK_LLM=false
# Mock 模式下每个 chunk 的间隔秒数，>0 能在前端看到打字机效果（演示用）
MOCK_LATENCY=0.0

# ---------- Agent 循环 ----------
MAX_ITERATIONS=10
MAX_RETRIES=3
RETRY_BACKOFF=1.5
MEMORY_MAX_TURNS=20
MEMORY_TOKEN_BUDGET=12000
MEMORY_SUMMARY_THRESHOLD=20
PARALLEL_TOOL_CALLS=true

# ---------- 工具 ----------
TOOL_TIMEOUT=30
CODE_EXEC_TIMEOUT=10
ENABLE_CODE_EXEC=true
FILE_OPS_MAX_CHARS=5000
FILE_OPS_MAX_BYTES=1000000
# 联网搜索（https://serper.dev）；不填则 search_web 标记为不可用，Mock 模式返回假数据
SERPER_API_KEY=

# ---------- 目录 ----------
# 文件类工具只能读写这个目录内的内容
WORKSPACE_DIR=./workspace
DATA_DIR=./data

# ---------- 会话 ----------
# memory = 进程内（重启丢）；sqlite = 落盘可恢复
SESSION_BACKEND=sqlite
# 留空则用 DATA_DIR/sessions.db
SESSION_DB_PATH=
SESSION_TTL=3600
MAX_SESSIONS=500

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
MAX_REQUEST_BYTES=256000

# ---------- 运行期改配置（危险，默认关闭）----------
# 打开后 POST /api/config 才能改 model/base_url/api_key，且必须同时设置 ADMIN_TOKEN
# 不放行时接口返回 403 runtime_config_disabled
ALLOW_RUNTIME_CONFIG=false
ADMIN_TOKEN=
